generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  AUCTIONEER
  BIDDER
}

enum LotStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum WalletTransactionType {
  OPENING_BALANCE
  OPENING_COMMITMENT
  DEPOSIT
  BID_COMMITTED
  BID_RELEASED
  AUCTION_DEBIT
  AUCTION_CREDIT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  wallet       Wallet?
  lots         Lot[]    @relation("SellerLots")
  bids         Bid[]
  wonLots      Lot[]    @relation("WinnerLots")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  committed Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  @@index([userId])
}

model WalletTransaction {
  id            String                @id @default(uuid())
  walletUserId  String
  type          WalletTransactionType
  amount        Int
  lotId         String?
  lotTitle      String?
  description   String
  createdAt     DateTime              @default(now())
  wallet        Wallet                @relation(fields: [walletUserId], references: [userId], onDelete: Cascade)
  @@index([walletUserId, createdAt])
}

model Lot {
  id                String    @id @default(uuid())
  sellerId          String
  pokemonId         Int
  title             String
  imagePath         String
  types             Json
  height            Int
  weight            Int
  stats             Json
  startingBid       Int
  minimumIncrement  Int       @default(100)
  currentBid        Int?
  endsAt            DateTime
  status            LotStatus @default(OPEN)
  winnerId          String?
  settledAt         DateTime?
  createdAt         DateTime  @default(now())
  seller            User      @relation("SellerLots", fields: [sellerId], references: [id])
  winner            User?     @relation("WinnerLots", fields: [winnerId], references: [id])
  bids              Bid[]
  @@index([status, endsAt])
  @@index([sellerId, status])
}

model Bid {
  id           String   @id @default(uuid())
  lotId        String
  bidderId     String
  sequence     Int
  amount       Int
  createdAt    DateTime @default(now())
  previousHash String?
  hash         String
  lot          Lot      @relation(fields: [lotId], references: [id])
  bidder       User     @relation(fields: [bidderId], references: [id])
  @@unique([lotId, sequence])
}
