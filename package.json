{
  "name": "pokemon-auction-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:e2e": "vite preview --port 4173 --strictPort",
    "typecheck:e2e": "tsc -p cypress/tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cypress:open": "cypress open --e2e",
    "cypress:run": "cypress run --e2e --browser electron",
    "test:e2e:ci": "start-server-and-test preview:e2e http://localhost:4173 cypress:run",
    "verify": "npm run build && npm run typecheck:e2e && npm run test:e2e:ci && npm run build-storybook"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "cypress": "^16.2.1",
    "postcss": "^8.5.3",
    "start-server-and-test": "^3.0.13",
    "storybook": "^10.6.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
